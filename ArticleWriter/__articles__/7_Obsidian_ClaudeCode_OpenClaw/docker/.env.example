# Second Brain Docker Stack -- Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# Path to Obsidian vault on the host
VAULT_PATH=/home/your-user/obsidian-vault

# User/group IDs (run `id` on the server to find yours)
PUID=1000
PGID=1000

# Timezone
TZ=Europe/Zurich

# REST API credentials
API_SECRET_KEY=generate-a-random-string-here
API_USER=admin
API_PASSWORD=pick-a-strong-password
